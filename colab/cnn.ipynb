   "source": [
    "import tensorflow as tf\n",
    "shape=(4,28,28,3)\n",
    "X=tf.random.normal(shape)\n",
    "y=tf.keras.layers.Conv2D(2,3,activation='relu',input_shape=(28,28,3))(X)\n",
    "# Conv2D의 첫번째 인자는 뉴런의 갯수, 두번째 인자는 커널의 크기, activation은 활성화 함수, input_shape는 입력 데이터의 형태\n",
    "# 윗 2이라는 값이 뉴런의 갯수\n",
    "print(y.shape)"
   ]
