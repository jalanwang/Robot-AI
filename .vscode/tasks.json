{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "mkdir -p \"${fileDirname}/bin\" && /usr/bin/g++ -g \"${file}\" -o \"${fileDirname}/bin/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles the active file to the bin directory."
        }
    ]
}